# Runtime environment for the Obligation Ledger app lane.
#
#   source /srv/ledger/app/ledger.env
#
# Every value is an override with a sane default in code, so nothing here is
# load-bearing except LLM_URL (the actual inference seam) and LEDGER_TOKEN.

# ---------------------------------------------------------------- inference
# The vLLM container publishes on the host at :8000. `inference.local` is the
# name the MASTER doc architecture uses and is what the OpenShell gateway will
# expose inside the sandbox; until that exists, point at the host directly.
# Add `127.0.0.1 inference.local` to /etc/hosts and both spellings work.
export LLM_URL="${LLM_URL:-http://localhost:8000/v1/chat/completions}"

# live | record | replay
#   live    call the endpoint
#   record  call it AND persist the raw response as a replay fixture
#   replay  read the fixture, never touch the network (stage insurance)
export LLM_MODE="${LLM_MODE:-live}"

# The catalog entry to use. The wire id is resolved from the endpoint at call
# time (vLLM serves 'qwen3-35b' from these weights), so this stays the
# human-facing name.
export LLM_MODEL="${LLM_MODEL:-Qwen/Qwen3.6-35B-A3B-FP8}"

# Document truncation. NOTE: the served model's --max-model-len is 32768
# TOKENS (~130k chars), so this char limit binds first by design. Raising it
# is not free: 07-ridgeline-supply-long.pdf is 57,614 chars with its renewal
# clause at offset 57,391 -- i.e. beyond this cut. Retrieval is the real fix.
export LLM_MAX_CHARS="${LLM_MAX_CHARS:-40000}"
export LLM_TIMEOUT="${LLM_TIMEOUT:-300}"

# ---------------------------------------------------------------- retrieval
# The RAG lane's Settings reads `.env` RELATIVE TO THE WORKING DIRECTORY, so an
# in-process import from /srv/ledger/app never sees rag-src/.env and falls back
# to its defaults. Its own env vars are therefore set here explicitly.
#
# LLM_MODEL above is the CATALOG name (resolved to the wire id per call by
# models.wire_name). The RAG lane has no such resolution, so it needs the id
# vLLM actually serves -- otherwise every call 404s.
export LLM_BASE_URL="${LLM_BASE_URL:-http://127.0.0.1:8000/v1}"
export LLM_API_KEY="${LLM_API_KEY:-local}"
export RAG_DATA_DIR="${RAG_DATA_DIR:-/srv/ledger/rag}"
export USE_FAKE_LLM="${USE_FAKE_LLM:-false}"
export USE_FAKE_EMBEDDINGS="${USE_FAKE_EMBEDDINGS:-false}"

# Retrieval is the PRIMARY answer path for document questions; the structured
# register handles counts, dates and workflow state. See chat.py.
export LEDGER_RAG="${LEDGER_RAG:-on}"
export LEDGER_RAG_K="${LEDGER_RAG_K:-8}"

# ---------------------------------------------------------------- storage
export LEDGER_DB="${LEDGER_DB:-/srv/ledger/data/ledger.db}"
export LEDGER_AUDIT="${LEDGER_AUDIT:-/srv/ledger/data/audit.jsonl}"
export LEDGER_INTAKE="${LEDGER_INTAKE:-/srv/ledger/intake,/srv/ledger/data/uploads}"
export LEDGER_OUT="${LEDGER_OUT:-/srv/ledger/outputs}"
export LEDGER_STATIC="${LEDGER_STATIC:-/srv/ledger/app/static}"
export LEDGER_FIXTURES="${LEDGER_FIXTURES:-/srv/ledger/data/fixtures}"
export LEDGER_UPLOADS="${LEDGER_UPLOADS:-/srv/ledger/data/uploads}"
export LEDGER_MODELS_DIR="${LEDGER_MODELS_DIR:-/home/dell/Desktop/Dell-Hackathon-Obligation-Ledger-AI-07-26-26/Models}"

# ---------------------------------------------------------------- app
# POC-grade single shared bearer token (D9). Override in the real environment;
# never write a real secret into this file.
export LEDGER_TOKEN="${LEDGER_TOKEN:-demo-token}"

# Retrieval seam (S2). 'on' is a no-op until the RAG lane replaces the stub.
export LEDGER_RAG="${LEDGER_RAG:-on}"

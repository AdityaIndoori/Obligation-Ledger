# RAG service configuration. Generated for this machine -- see the app lane's
# implog for why each value is what it is.
#
# NOTE the model id. Their example defaults to gpt-oss-120b, but the vLLM
# container on this box is launched with --served-model-name=qwen3-35b from the
# Qwen3.6-35B-A3B-FP8 weights. Sending the wrong id is a 404, so this must match
# what `curl :8000/v1/models` actually reports.

# --- Local reasoning model (the same vLLM the app lane uses) ---
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=local
LLM_MODEL=qwen3-35b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=4096

# Real model, not the stand-in. Their fake adapter exists so a UI can be built
# before a server exists; we have a server, so we use it.
USE_FAKE_LLM=false

# --- Embeddings ---
# No sentence-transformers weights are staged on this box, and nothing may be
# downloaded at runtime (that is the product's central claim). BM25-only is
# their documented, supported mode and is sufficient for extraction; the dense
# side only sharpens natural-language Ask.
EMBEDDING_MODEL_PATH=
USE_FAKE_EMBEDDINGS=false
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# --- Storage / service ---
# Under /srv/ledger so it lands inside the same volume the OpenShell sandbox
# will mount, per their §9.
RAG_DATA_DIR=/srv/ledger/rag
RAG_HOST=0.0.0.0
RAG_PORT=8001

# --- Chunking / retrieval tuning ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
DEFAULT_TOP_K=6
RRF_K=60

# --- Verification thresholds ---
FUZZY_MATCH_THRESHOLD=0.92
FUZZY_MAX_LENGTH_RATIO=1.35
